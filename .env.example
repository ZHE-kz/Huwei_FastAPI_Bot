# LINE Developers
LINE_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF (LINE Login Channel ID, not Messaging API Channel ID)
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LIFF_SESSION_SECRET=
PROFILE_PUBLIC_BASE_URL=https://your-cloud-run-domain.example
LIFF_COOKIE_SECURE=true
# One independent Login Channel may serve all configured Bot accounts.

# Optional language-specific Rich Menu IDs
RICH_MENU_ZH_TW=
RICH_MENU_EN_US=
RICH_MENU_JA_JP=

# External APIs
GEMINI_API_KEY=
CWA_API_KEY=

# Application
GOOGLE_DRIVE_FOLDER_ID=
ADMIN_TOKEN=
PUZZLE_ADMIN_SECRET=

# Local Google Cloud authentication (optional on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_CLOUD_PROJECT=
